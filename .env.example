# Copy to .env.local. The demo uses the hosted Supabase project (dashboard → Project Settings → API
# keys, and Connect for the database URI).

# --- Site ---
# Canonical origin for links, sitemaps and structured data. Vercel Production: https://bahramsilk.com
# (no trailing slash; www redirects to it). Only the Production deployment is indexable.
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# --- Search engines (optional; DNS verification of a Search Console Domain property needs none) ---
# Content of the "HTML tag" verification code only, e.g. abc123… (not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://csduibahmolbagejicfq.supabase.co
# Publishable key (sb_publishable_…) or legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) or legacy service_role key. Server only. Bypasses RLS: used by webhooks,
# cron handlers and scripts, never by page rendering.
SUPABASE_SERVICE_ROLE_KEY=
# Used by `npm run db:push`, the weekly backup workflow and ad-hoc scripts, not by the app.
# Percent-encode special characters in the password (e.g. ? → %3F, / → %2F).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.csduibahmolbagejicfq.supabase.co:5432/postgres

# --- Razorpay (TEST MODE ONLY while hosted on Vercel Hobby; see docs/adr/0004) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email (Nodemailer over SMTP, e.g. Brevo free tier; not needed until transactional email is built) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Bahram Silks <care@bahramsilk.com>"

# --- Cron: Vercel Cron and manual calls must send `Authorization: Bearer $CRON_SECRET` ---
CRON_SECRET=

# --- Messaging and analytics ---
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
