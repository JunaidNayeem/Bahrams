# Copy to .env.local. For local dev, fill the Supabase values from `npx supabase status -o env`
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY, DB_URL).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by webhooks and cron handlers, never by page rendering.
SUPABASE_SERVICE_ROLE_KEY=
# Used by the weekly backup workflow and ad-hoc scripts, not by the app.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Razorpay (TEST MODE ONLY while hosted on Vercel Hobby; see docs/adr/0004) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email (Nodemailer over SMTP, e.g. Brevo free tier; local dev uses Mailpit) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Bahram Silks <care@bahramsilks.com>"

# --- Cron: Vercel Cron and manual calls must send `Authorization: Bearer $CRON_SECRET` ---
CRON_SECRET=

# --- Messaging and analytics ---
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
